{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=chuvasegura-monitoramento.db"
  },
  "Seed": {
    "Habilitado": true
  },
  "RegrasRisco": {
    "AtencaoCm": 30,
    "AlertaCm": 60,
    "MinutosParaDadoDesatualizado": 15
  },
  "AlertasService": {
    "Habilitado": true,
    "BaseUrl": "http://localhost:8080",
    "Caminho": "/api/alertas/notificacoes",
    "TimeoutSegundos": 5
  }
}
